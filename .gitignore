__pycache__/
*.pyc
.DS_Store
*.log

# Host software build output
soft/build/
compile_commands.json
*.o
*.a

# FPGA build output.  Vivado projects are large and entirely reproducible from
# the scripts in fpga/build, so none of it belongs in the repository.
build_ooc/
build_b210/
*.jou
*.str
vivado*.log
.Xil/

# Verilator scratch
fpga/sim/obj_dir/
fpga/sim/*.vcd
fpga/sim/build/

# Generated by fpga/build/integrate_b200.py against whichever UHD tree is in
# use, so it is specific to that checkout rather than to this project.
fpga/rtl/radar_b200_shim.v

# Recordings. These get large quickly and disk is scarce on the build machine.
*.rdr

# Verilator scratch created by the fpga/sim run scripts
fpga/build/*/
